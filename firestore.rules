rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /sharedWireframes/{shareId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sharedReports/{shareId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /contentHub/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /contentHubMeta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /contentPlan/{itemId} {
      // Unlike contentHub, this is unreleased FY27 campaign/content strategy — no public read.
      allow read, write: if request.auth != null;
    }
    match /contentPlanPresence/{sessionId} {
      // Ephemeral live-cursor docs, one per open tab — ok for any signed-in user to write their own and read everyone's.
      allow read, write: if request.auth != null;
    }
  }
}
